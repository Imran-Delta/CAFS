--- /dev/null
+++ b/src/safety.rs
@@ -0,0 +1,219 @@
+//! Guards for pointing destructive tooling (mkfs, the device test
+//! suite) at a real block device. Defence in depth, in this order:
+//!  1. kernel: `FileDevice` opens a block device for writing with
+//!     `O_EXCL`, which the kernel refuses (EBUSY) while the device is
+//!     mounted, in use as swap, or claimed by another driver;
+//!  2. this module: refuse whole disks that have partitions, devices
+//!     with holders (dm/md/LUKS on top), anything listed in
+//!     `/proc/self/mountinfo` or `/proc/swaps`, and any device whose
+//!     first 128 KiB carry a filesystem signature other than "empty",
+//!     "swap" or "CAFS" — so a mistyped partition number cannot
+//!     silently flatten an NTFS/ext4/btrfs volume.
+//!
+//! Linux only (sysfs, procfs).
+//!
+//! SPDX-License-Identifier: BSD-3-Clause
+//! Copyright (c) 2026, Imran Bin Gifary (System Delta)
+
+use std::fs;
+use std::io::Read;
+use std::os::unix::fs::{FileTypeExt, MetadataExt};
+use std::path::{Path, PathBuf};
+
+use crate::device::FileDevice;
+use crate::layout::PTR_MAGIC;
+
+/// What a device's first 128 KiB look like.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Signature {
+    Empty,
+    Swap,
+    Cafs,
+    Ntfs,
+    Fat,
+    Ext,
+    Btrfs,
+    Xfs,
+    Luks,
+    Other,
+}
+
+impl Signature {
+    /// Signatures a destructive CAFS tool may overwrite without being
+    /// told to wipe the device first.
+    pub const OVERWRITABLE: [Signature; 3] = [Signature::Empty, Signature::Swap, Signature::Cafs];
+}
+
+pub fn detect_signature(b: &[u8]) -> Signature {
+    let at = |off: usize, pat: &[u8]| b.len() >= off + pat.len() && &b[off..off + pat.len()] == pat;
+    if at(0, &PTR_MAGIC) {
+        Signature::Cafs
+    } else if at(4086, b"SWAPSPACE2") || at(4086, b"SWAP-SPACE") {
+        Signature::Swap
+    } else if at(3, b"NTFS    ") {
+        Signature::Ntfs
+    } else if at(82, b"FAT32") || at(54, b"FAT16") || at(54, b"FAT12") {
+        Signature::Fat
+    } else if at(1080, &[0x53, 0xEF]) {
+        Signature::Ext
+    } else if at(65600, b"_BHRfS_M") {
+        Signature::Btrfs
+    } else if at(0, b"XFSB") {
+        Signature::Xfs
+    } else if at(0, b"LUKS\xba\xbe") {
+        Signature::Luks
+    } else if b.iter().all(|&x| x == 0) {
+        Signature::Empty
+    } else {
+        Signature::Other
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct TargetInfo {
+    pub path: PathBuf,
+    pub kernel_name: String,
+    pub size: u64,
+    pub logical_sector: Option<u32>,
+    pub physical_sector: Option<u32>,
+    pub rotational: Option<bool>,
+    pub is_partition: bool,
+    pub signature: Signature,
+}
+
+fn rdev_of(path: &Path) -> Option<u64> {
+    let m = fs::metadata(path).ok()?;
+    m.file_type().is_block_device().then(|| m.rdev())
+}
+
+fn read_trim(p: impl AsRef<Path>) -> Option<String> {
+    fs::read_to_string(p).ok().map(|s| s.trim().to_string())
+}
+
+/// Check that `path` is a block device that is safe to overwrite.
+/// `Ok` carries what was learned about it; `Err` is a human-readable
+/// reason to stop.
+pub fn check_target(path: &str, allowed: &[Signature]) -> Result<TargetInfo, String> {
+    let meta = fs::metadata(path).map_err(|e| format!("{path}: {e}"))?;
+    if !meta.file_type().is_block_device() {
+        return Err(format!("{path} is not a block device"));
+    }
+    let rdev = meta.rdev();
+    let (maj, min) = (rustix::fs::major(rdev), rustix::fs::minor(rdev));
+    let sys = fs::canonicalize(format!("/sys/dev/block/{maj}:{min}"))
+        .map_err(|e| format!("cannot resolve {maj}:{min} in sysfs: {e}"))?;
+    let kernel_name = sys.file_name().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+    let is_partition = sys.join("partition").exists();
+
+    // Devices that belong to this target: itself, plus its partitions.
+    let mut mine: Vec<(u32, u32)> = vec![(maj, min)];
+    if !is_partition {
+        let mut children = 0;
+        if let Ok(rd) = fs::read_dir(&sys) {
+            for e in rd.flatten() {
+                if e.path().join("partition").exists() {
+                    children += 1;
+                    if let Some(d) = read_trim(e.path().join("dev")) {
+                        if let Some((a, b)) = d.split_once(':') {
+                            if let (Ok(a), Ok(b)) = (a.parse(), b.parse()) {
+                                mine.push((a, b));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        if children > 0 {
+            return Err(format!("{path} is a whole disk with {children} partition(s); name a partition instead"));
+        }
+    }
+    if let Ok(rd) = fs::read_dir(sys.join("holders")) {
+        if rd.count() > 0 {
+            return Err(format!("{path} has holders (device-mapper/md/LUKS on top of it)"));
+        }
+    }
+
+    let is_mine = |p: &Path| rdev_of(p).is_some_and(|r| mine.contains(&(rustix::fs::major(r), rustix::fs::minor(r))));
+    if let Ok(mi) = fs::read_to_string("/proc/self/mountinfo") {
+        for line in mi.lines() {
+            let mut halves = line.splitn(2, " - ");
+            let (pre, post) = (halves.next().unwrap_or(""), halves.next().unwrap_or(""));
+            let devno = pre.split_whitespace().nth(2).unwrap_or("");
+            let source = post.split_whitespace().nth(1).unwrap_or("");
+            let by_devno = devno
+                .split_once(':')
+                .and_then(|(a, b)| Some((a.parse().ok()?, b.parse().ok()?)))
+                .is_some_and(|d| mine.contains(&d));
+            if by_devno || is_mine(Path::new(source)) {
+                return Err(format!("{path} (or a partition of it) is mounted: {}", line.split_whitespace().nth(4).unwrap_or("?")));
+            }
+        }
+    }
+    if let Ok(sw) = fs::read_to_string("/proc/swaps") {
+        for line in sw.lines().skip(1) {
+            if let Some(p) = line.split_whitespace().next() {
+                if is_mine(Path::new(p)) {
+                    return Err(format!("{path} is active swap ({p}); run `swapoff {p}` first"));
+                }
+            }
+        }
+    }
+
+    let rotational = {
+        let disk = if is_partition { sys.parent().map(Path::to_path_buf).unwrap_or(sys.clone()) } else { sys.clone() };
+        read_trim(disk.join("queue/rotational")).map(|s| s == "1")
+    };
+
+    let dev = FileDevice::open(path, false).map_err(|e| format!("{path}: cannot open for reading: {e}"))?;
+    let size = crate::device::Device::size(&dev);
+    let (logical_sector, physical_sector) = dev.sector_sizes();
+
+    let mut head = vec![0u8; 128 * 1024];
+    let n = fs::File::open(path)
+        .and_then(|mut f| f.read(&mut head))
+        .map_err(|e| format!("{path}: cannot read signature: {e}"))?;
+    let signature = detect_signature(&head[..n]);
+    if !allowed.contains(&signature) {
+        let what = if signature == Signature::Other {
+            "data that is not empty, swap or CAFS (an unrecognised filesystem, LVM, leftovers...)".to_string()
+        } else {
+            format!("a {signature:?} signature")
+        };
+        return Err(format!(
+            "{path} holds {what}; refusing to overwrite it. If you are sure it is expendable, clear its start yourself first: `dd if=/dev/zero of={path} bs=1M count=1 conv=fsync`"
+        ));
+    }
+
+    Ok(TargetInfo { path: PathBuf::from(path), kernel_name, size, logical_sector, physical_sector, rotational, is_partition, signature })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn page(f: impl FnOnce(&mut Vec<u8>)) -> Vec<u8> {
+        let mut v = vec![0u8; 128 * 1024];
+        f(&mut v);
+        v
+    }
+
+    #[test]
+    fn recognises_common_signatures() {
+        assert_eq!(detect_signature(&page(|_| {})), Signature::Empty);
+        assert_eq!(detect_signature(&page(|v| v[4086..4096].copy_from_slice(b"SWAPSPACE2"))), Signature::Swap);
+        assert_eq!(detect_signature(&page(|v| v[3..11].copy_from_slice(b"NTFS    "))), Signature::Ntfs);
+        assert_eq!(detect_signature(&page(|v| v[1080..1082].copy_from_slice(&[0x53, 0xEF]))), Signature::Ext);
+        assert_eq!(detect_signature(&page(|v| v[65600..65608].copy_from_slice(b"_BHRfS_M"))), Signature::Btrfs);
+        assert_eq!(detect_signature(&page(|v| v[0..8].copy_from_slice(&PTR_MAGIC))), Signature::Cafs);
+        assert_eq!(detect_signature(&page(|v| v[500] = 1)), Signature::Other);
+    }
+
+    #[test]
+    fn regular_files_and_missing_paths_are_refused() {
+        assert!(check_target("/definitely/not/here", &Signature::OVERWRITABLE).is_err());
+        let d = tempfile::tempdir().unwrap();
+        let p = d.path().join("f");
+        std::fs::write(&p, b"x").unwrap();
+        assert!(check_target(p.to_str().unwrap(), &Signature::OVERWRITABLE).unwrap_err().contains("not a block device"));
+    }
+}
diff --git a/tests/adaptive.rs b/tests/adaptive.rs
new file mode 100644
index 0000000..3358804
--- /dev/null
+++ b/tests/adaptive.rs
@@ -0,0 +1,160 @@
+//! Adaptive suite: the same scenarios run on a disk image (default) or
+//! on a real block device:
+//!
+//!   CAFS_TEST_DEVICE=/dev/sdXN CAFS_TEST_DEVICE_I_AGREE=/dev/sdXN \
+//!       cargo test --test adaptive --test bench -- --test-threads=1 --nocapture
+//!
+//! Corruption is applied with raw bypass writes (real bytes on the
+//! medium), recovery goes through the normal mount/check path, and the
+//! result is verified by an O_DIRECT read where the platform allows.
+
+mod common;
+use common::*;
+
+use cafs_io::layout::*;
+use cafs_io::{ByteOffset, CafsError, MountMode, Side};
+
+const IMG: u64 = 4 * 1024 * 1024;
+
+fn u32_at(b: &[u8], o: usize) -> u32 {
+    u32::from_le_bytes(b[o..o + 4].try_into().unwrap())
+}
+fn u64_at(b: &[u8], o: usize) -> u64 {
+    u64::from_le_bytes(b[o..o + 8].try_into().unwrap())
+}
+
+#[test]
+fn lifecycle_format_mount_check_confirm() {
+    let t = Target::acquire(IMG);
+    t.format();
+    println!("target: {}", t.describe());
+    let sb_before = t.peek(SB_OFF, 4096);
+
+    for cycle in 1..=2u32 {
+        let mut c = t.mount(true).unwrap();
+        assert_eq!(c.device_size(), t.size);
+        assert!(c.anchors().iter().all(|r| r.head_ok() && r.tail_ok() && !r.disagree()));
+        let r = c.check().unwrap();
+        assert!(r.superblock_ok && r.anchor_slots_degraded == 0 && !r.superblock_repaired);
+        c.confirm().unwrap();
+        c.close().unwrap();
+
+        let (smart, how) = t.peek_media(SMART_OFF, 4096);
+        assert_eq!(u32_at(&smart, SMART_OFF_MOUNT_COUNT), cycle, "mount_count ({how})");
+        assert!(u64_at(&smart, SMART_OFF_LAST_MOUNT_TIME) > 1_700_000_000, "last_mount_time ({how})");
+        assert!(blake3_128_ok(&smart, SMART_HASHED_LEN), "M-SMART checksum ({how})");
+    }
+    assert_eq!(t.peek_media(SB_OFF, 4096).0, sb_before, "confirm() must not touch the Superblock");
+}
+
+#[test]
+fn head_sector_destroyed_recovers_from_the_tail_and_is_rebuilt_exactly() {
+    let t = Target::acquire(IMG);
+    t.format();
+    let before = t.peek(0, 4096);
+    t.poke(0, &[0u8; 4096]);
+
+    let mut c = t.mount(true).unwrap();
+    assert_eq!(c.anchors()[0].used(), Some(Side::Tail));
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired), (2, 2));
+    drop(c);
+    let (after, how) = t.peek_media(0, 4096);
+    assert_eq!(after, before, "head rebuilt byte-for-byte ({how})");
+}
+
+#[test]
+fn tail_region_destroyed_recovers_from_the_head_and_is_rebuilt_exactly() {
+    let t = Target::acquire(IMG);
+    t.format();
+    let tail = t.size - ANCHOR_REGION_BYTES;
+    let before = t.peek(tail, ANCHOR_REGION_BYTES as usize);
+    t.poke(tail, &vec![0u8; ANCHOR_REGION_BYTES as usize]);
+
+    let mut c = t.mount(true).unwrap();
+    assert!(c.anchors().iter().all(|r| r.used() == Some(Side::Head)));
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired), (6, 6));
+    drop(c);
+    let (after, how) = t.peek_media(tail, ANCHOR_REGION_BYTES as usize);
+    assert_eq!(after, before, "tail rebuilt byte-for-byte ({how})");
+}
+
+#[test]
+fn superblock_corruption_is_repaired_from_the_backup_at_the_end_of_the_device() {
+    let t = Target::acquire(IMG);
+    t.format();
+    let before = t.peek(SB_OFF, 4096);
+    let mut bad = before.clone();
+    bad[100] ^= 0xFF;
+    t.poke(SB_OFF, &bad);
+
+    let mut c = t.mount(true).unwrap();
+    let r = c.check().unwrap();
+    assert!(r.superblock_ok && r.superblock_repaired);
+    drop(c);
+    assert_eq!(t.peek_media(SB_OFF, 4096).0, before);
+    assert_eq!(t.peek(sb_backup_offset(t.size).0, 4096), before, "backup untouched");
+}
+
+#[test]
+fn both_ends_of_lba0_destroyed_refuses_full_mount_but_bypass_still_opens() {
+    let t = Target::acquire(IMG);
+    t.format();
+    t.poke(0, &[0u8; 2048]);
+    t.poke(tail_slot_offset(0, t.size).0, &[0u8; 2048]);
+
+    assert!(matches!(t.mount(false), Err(CafsError::BadMagic)));
+    let mut c = t.bypass(false);
+    let mut b = [0u8; 16];
+    c.read_block(ByteOffset(SB_OFF), &mut b).unwrap(); // data still reachable raw
+    drop(c);
+
+    t.format();
+    assert!(t.mount(false).is_ok(), "re-format restores a mountable volume");
+}
+
+#[test]
+fn raw_io_works_at_the_edges_and_never_leaves_the_device() {
+    let t = Target::acquire(IMG);
+    t.format();
+    let mut c = t.bypass(true);
+    assert_eq!(c.device_size(), t.size);
+    let spots = [0u64, 4096, t.size / 2 / 4096 * 4096, t.size - 4096];
+    for (i, &off) in spots.iter().enumerate() {
+        let pat = vec![0xC0 + i as u8; 4096];
+        c.write_block(ByteOffset(off), &pat).unwrap();
+    }
+    c.sync().unwrap();
+    // Unaligned (bounce) write at the very last bytes.
+    c.write_block(ByteOffset(t.size - 3), &[1, 2, 3]).unwrap();
+    c.sync().unwrap();
+    assert_eq!(c.write_block(ByteOffset(t.size - 2), &[9, 9, 9]), Err(CafsError::OutOfRange));
+    assert_eq!(c.write_block(ByteOffset(t.size), &[9]), Err(CafsError::OutOfRange));
+    drop(c);
+
+    for (i, &off) in spots.iter().enumerate() {
+        let (got, how) = t.peek_media(off, 4096);
+        let mut want = vec![0xC0 + i as u8; 4096];
+        if off == t.size - 4096 {
+            let n = want.len();
+            want[n - 3..].copy_from_slice(&[1, 2, 3]);
+        }
+        assert_eq!(got, want, "pattern at {off} ({how})");
+    }
+}
+
+#[test]
+fn a_second_writer_is_refused_while_one_holds_the_device() {
+    let t = Target::acquire(IMG);
+    if !t.is_device() {
+        eprintln!("skipped: exclusive claim (O_EXCL) exists only for block devices");
+        return;
+    }
+    t.format();
+    let held = t.bypass(true);
+    assert!(matches!(cafs_io::CafsCtx::mount_with(&t.path, true, MountMode::Bypass), Err(CafsError::Open)));
+    assert!(cafs_io::CafsCtx::mount_with(&t.path, false, MountMode::Bypass).is_ok(), "inspection stays possible");
+    drop(held);
+    assert!(cafs_io::CafsCtx::mount_with(&t.path, true, MountMode::Bypass).is_ok());
+}
diff --git a/tests/anchors.rs b/tests/anchors.rs
new file mode 100644
index 0000000..2e3b184
--- /dev/null
+++ b/tests/anchors.rs
@@ -0,0 +1,187 @@
+//! Head + end-of-device anchor pointer blocks (fs.info §2, §3, §12,
+//! §14 Track A) as the engine now uses them.
+
+mod common;
+use common::*;
+
+use cafs_io::anchor::build_ptr_block;
+use cafs_io::fault::FaultDevice;
+use cafs_io::layout::*;
+use cafs_io::{CafsCtx, CafsError, MountOpts, PtrAlgo, Side};
+
+const SZ: u64 = 1024 * 1024;
+
+fn img() -> Vec<u8> {
+    formatted_image(SZ)
+}
+fn zero(dev: &FaultDevice, off: u64, n: usize) {
+    dev.poke(off, &vec![0u8; n]);
+}
+fn mount_rw(dev: &FaultDevice) -> CafsCtx {
+    CafsCtx::mount_device(Box::new(dev.clone()), true).unwrap()
+}
+
+#[test]
+fn fresh_volume_has_twelve_good_pointer_blocks_and_the_mirror_matches() {
+    let image = img();
+    let (_d, c) = mount_image(image.clone(), false).unwrap();
+    for r in c.anchors() {
+        assert!(r.head_ok() && r.tail_ok() && !r.disagree(), "slot {}", r.slot);
+        assert_eq!(r.used(), Some(Side::Head));
+    }
+    // Slots 1-5: tail is a byte-for-byte copy of the head.
+    for slot in 1..6u8 {
+        let n = slot_block_size(slot) as usize;
+        let (h, t) = (head_slot_offset(slot).0 as usize, tail_slot_offset(slot, SZ).0 as usize);
+        assert_eq!(image[h..h + n], image[t..t + n], "slot {slot}");
+    }
+    // Slot 0: tail swaps primary and fallback.
+    let (primary, backup) = c.anchors()[0].sb_pair().unwrap();
+    assert_eq!(primary.0, SB_OFF);
+    assert_eq!(backup.unwrap(), sb_backup_offset(SZ));
+}
+
+#[test]
+fn lba0_checksum_flip_mounts_from_the_tail() {
+    let dev = FaultDevice::from_image(img());
+    dev.flip_byte(24);
+    let mut c = mount_rw(&dev);
+    assert_eq!(c.anchors()[0].used(), Some(Side::Tail));
+    assert!(c.check().unwrap().superblock_ok);
+}
+
+#[test]
+fn first_sector_zeroed_mounts_and_check_rebuilds_the_heads_byte_for_byte() {
+    let original = img();
+    let dev = FaultDevice::from_image(original.clone());
+    zero(&dev, 0, 4096); // LBA0 + LBA1 heads
+    let mut c = mount_rw(&dev);
+    assert_eq!(c.anchors()[1].used(), Some(Side::Tail));
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired, r.anchor_slots_lost), (2, 2, 0));
+    assert_eq!(dev.durable_image()[0..4096], original[0..4096]);
+    assert!(c.anchors().iter().all(|r| r.head_ok() && r.tail_ok()));
+}
+
+#[test]
+fn unreadable_head_sector_mounts_from_the_tail() {
+    let dev = FaultDevice::from_image(img());
+    dev.add_bad_read_range(0, 4096);
+    let mut c = mount_rw(&dev);
+    let r = c.check().unwrap();
+    assert_eq!(r.anchor_slots_degraded, 2);
+    assert!(r.superblock_ok);
+    // Rewriting cannot cure a sector that still cannot be read.
+    assert!(!c.anchors()[0].head_ok());
+}
+
+#[test]
+fn both_ends_of_lba0_bad_is_unmountable() {
+    let dev = FaultDevice::from_image(img());
+    dev.flip_byte(24);
+    dev.flip_byte(tail_slot_offset(0, SZ).0 + 24);
+    assert!(matches!(CafsCtx::mount_device(Box::new(dev), false), Err(CafsError::Checksum)));
+}
+
+#[test]
+fn both_ends_of_a_non_root_slot_bad_is_reported_lost_but_mount_succeeds() {
+    let dev = FaultDevice::from_image(img());
+    dev.flip_byte(head_slot_offset(2).0 + 24);
+    dev.flip_byte(tail_slot_offset(2, SZ).0 + 24);
+    let mut c = mount_rw(&dev);
+    assert_eq!(c.check().unwrap().anchor_slots_lost, 1);
+}
+
+#[test]
+fn damaged_head_fallback_is_detected_and_the_head_rebuilt() {
+    let original = img();
+    let dev = FaultDevice::from_image(original.clone());
+    dev.flip_byte(1048); // head LBA0 fallback_checksum
+    let mut c = mount_rw(&dev);
+    assert!(c.anchors()[0].head_ok() && !c.anchors()[0].head_good());
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired), (1, 1));
+    assert_eq!(dev.durable_image()[0..2048], original[0..2048]);
+}
+
+#[test]
+fn damaged_fallback_pointer_plus_bad_superblock_now_recovers_via_the_tail() {
+    // As uploaded this combination was unrecoverable.
+    let dev = FaultDevice::from_image(img());
+    dev.flip_byte(1034); // head LBA0 fallback_real_lba
+    dev.flip_byte(SB_OFF + 100);
+    let mut c = mount_rw(&dev);
+    let r = c.check().unwrap();
+    assert!(r.superblock_ok && r.superblock_repaired);
+}
+
+#[test]
+fn readonly_mount_reports_damage_but_writes_nothing() {
+    let dev = FaultDevice::from_image(img());
+    zero(&dev, 0, 4096);
+    let mut c = CafsCtx::mount_device(Box::new(dev.clone()), false).unwrap();
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired), (2, 0));
+    assert_eq!(dev.counters().writes, 0);
+}
+
+#[test]
+fn software_readonly_remount_blocks_repairs() {
+    // remount.rs documents that check()'s repair path honours
+    // opts.readonly; as uploaded it did not.
+    let dev = FaultDevice::from_image(img());
+    dev.flip_byte(SB_OFF + 100);
+    zero(&dev, 0, 4096);
+    let mut c = mount_rw(&dev);
+    c.remount(&MountOpts { readonly: true, ..Default::default() }).unwrap();
+    let r = c.check().unwrap();
+    assert!(r.superblock_ok && !r.superblock_repaired);
+    assert_eq!(r.anchor_slots_repaired, 0);
+    assert_eq!(dev.counters().writes, 0);
+}
+
+#[test]
+fn ends_that_verify_but_disagree_are_reported_and_head_wins() {
+    let dev = FaultDevice::from_image(img());
+    let other = build_ptr_block(PTR_BLOCK_SMALL_SIZE, PtrAlgo::Crc32c, 8 * 4096, 4096, None);
+    dev.poke(head_slot_offset(1).0, &other);
+    let mut c = mount_rw(&dev);
+    assert_eq!(c.anchors()[1].used(), Some(Side::Head));
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_disagreements, r.anchor_slots_degraded), (1, 0));
+}
+
+#[test]
+fn grown_device_orphans_the_tail_and_check_rebuilds_it_at_the_new_end() {
+    // The Superblock has no device-size field (fs.info §4), so a
+    // device that grew outside CAFS cannot be told apart from damage.
+    let mut grown = img();
+    grown.resize(2 * SZ as usize, 0);
+    let dev = FaultDevice::from_image(grown);
+    let mut c = mount_rw(&dev);
+    assert!(c.anchors().iter().all(|r| r.head_ok() && !r.tail_ok()));
+    let r = c.check().unwrap();
+    assert_eq!((r.anchor_slots_degraded, r.anchor_slots_repaired), (6, 6));
+    assert!(c.anchors().iter().all(|r| r.head_ok() && r.tail_ok()));
+    // Real structures stay where they were; pointers are authoritative.
+    assert_eq!(c.anchors()[0].sb_pair().unwrap().1.unwrap(), sb_backup_offset(SZ));
+    assert_ne!(sb_backup_offset(SZ), sb_backup_offset(2 * SZ));
+}
+
+#[test]
+fn known_hazard_shrunk_device_check_overwrites_live_structures_with_a_new_tail() {
+    // Same blindness in the other direction: after a shrink the
+    // "end of device" lies inside what used to be the real tail
+    // region, and check() writes a mirror over whatever is there —
+    // here the Superblock Backup. PINS A HAZARD, not a desired result.
+    let original = img();
+    let mut shrunk = original.clone();
+    shrunk.truncate(SZ as usize - 16384);
+    let old_backup = sb_backup_offset(SZ).0 as usize;
+    assert_eq!(shrunk[old_backup..old_backup + 4096], original[SB_OFF as usize..SB_OFF as usize + 4096]);
+    let dev = FaultDevice::from_image(shrunk);
+    let mut c = mount_rw(&dev);
+    c.check().unwrap();
+    let after = dev.durable_image();
+    assert_ne!(after[old_backup..old_backup + 4096], original[SB_OFF as usize..SB_OFF as usize + 4096]);
+}
diff --git a/tests/bench.rs b/tests/bench.rs
new file mode 100644
index 0000000..b3a53ea
--- /dev/null
+++ b/tests/bench.rs
@@ -0,0 +1,92 @@
+//! Latency of engine operations on the chosen target. Numbers from a
+//! disk image are page-cache numbers; point CAFS_TEST_DEVICE at a real
+//! partition (see adaptive.rs) for device numbers. Reads are buffered,
+//! so a warm run measures the page cache, not the platter.
+
+mod common;
+use common::*;
+
+use std::time::{Duration, Instant};
+
+use cafs_io::layout::*;
+use cafs_io::{ByteOffset, CafsCtx};
+
+const IMG: u64 = 4 * 1024 * 1024;
+const N: usize = 15;
+
+fn stats(mut v: Vec<Duration>) -> (f64, f64, f64) {
+    v.sort();
+    let ms = |d: Duration| d.as_secs_f64() * 1000.0;
+    (ms(v[0]), ms(v[v.len() / 2]), ms(v[v.len() - 1]))
+}
+
+fn row(name: &str, v: Vec<Duration>) {
+    let (min, med, max) = stats(v);
+    println!("{name:<46} {min:>9.3} {med:>9.3} {max:>9.3}");
+}
+
+#[test]
+fn bench_operation_latency() {
+    let t = Target::acquire(IMG);
+    println!("\ntarget: {}", t.describe());
+    let t0 = Instant::now();
+    t.format();
+    println!("mkfs_cafs (wipe + format + fsync): {:.1} ms\n", t0.elapsed().as_secs_f64() * 1000.0);
+    println!("{:<46} {:>9} {:>9} {:>9}", "operation (ms)", "min", "median", "max");
+
+    let mut v = Vec::new();
+    for _ in 0..N {
+        let t0 = Instant::now();
+        let c = CafsCtx::mount(&t.path, false).unwrap();
+        v.push(t0.elapsed());
+        drop(c);
+    }
+    row("mount (16 reads)", v);
+
+    let (mut vc, mut vf) = (Vec::new(), Vec::new());
+    for _ in 0..N {
+        let mut c = t.mount(true).unwrap();
+        let t0 = Instant::now();
+        c.check().unwrap();
+        vc.push(t0.elapsed());
+        let t0 = Instant::now();
+        c.confirm().unwrap();
+        vf.push(t0.elapsed());
+    }
+    row("check, clean volume", vc);
+    row("confirm (1 write + 1 sync, was 4 + 4)", vf);
+
+    let mut c = t.bypass(true);
+    let mut timed = |name: &str, off: u64, len: usize| {
+        let mut cur = vec![0u8; len];
+        c.read_block(ByteOffset(off), &mut cur).unwrap();
+        let mut v = Vec::new();
+        for _ in 0..N {
+            let t0 = Instant::now();
+            c.write_block(ByteOffset(off), &cur).unwrap(); // same bytes: content unchanged
+            c.sync().unwrap();
+            v.push(t0.elapsed());
+        }
+        row(name, v);
+    };
+    timed("write 144 B + sync @ M-SMART (start of disk)", SMART_OFF, SMART_TABLE_SIZE);
+    timed("write 2048 B + sync @ LBA0 head (start)", 0, 2048);
+    timed("write 4096 B + sync @ LBA4 head (start)", LBA4_OFFSET.0, 4096);
+    timed("write 4096 B + sync @ LBA5 tail (END of device)", tail_slot_offset(5, t.size).0, 4096);
+    timed("write 4096 B + sync @ Superblock Backup (end)", sb_backup_offset(t.size).0, 4096);
+    drop(c);
+
+    let mut v = Vec::new();
+    for _ in 0..N {
+        t.poke(tail_slot_offset(0, t.size).0, &[0u8; 2048]);
+        let mut c = t.mount(true).unwrap();
+        let t0 = Instant::now();
+        let r = c.check().unwrap();
+        v.push(t0.elapsed());
+        assert_eq!(r.anchor_slots_repaired, 1);
+    }
+    row("check + rebuild tail LBA0 (end) incl. 12-block rescan", v);
+
+    t.format();
+    println!("\nbuffered I/O: 2048 B vs 4096 B rows compare page-cache behaviour, not raw device RMW.");
+}
diff --git a/tests/bypass.rs b/tests/bypass.rs
new file mode 100644
index 0000000..4e904c2
--- /dev/null
+++ b/tests/bypass.rs
@@ -0,0 +1,72 @@
+//! MountMode::Bypass — raw engine I/O without mount, for inspecting
+//! and modifying a disk (including one Full mount refuses).
+
+mod common;
+use common::*;
+
+use cafs_io::{ByteOffset, CafsCtx, CafsError, MountMode, MountOpts};
+
+const SZ: u64 = 1024 * 1024;
+
+fn file_image(name: &str) -> (tempfile::TempDir, String) {
+    let d = tempfile::tempdir().unwrap();
+    let p = d.path().join(name);
+    std::fs::write(&p, formatted_image(SZ)).unwrap();
+    let s = p.to_str().unwrap().to_string();
+    (d, s)
+}
+
+#[test]
+fn bypass_opens_a_volume_that_full_mount_refuses_and_modifies_it() {
+    let (_d, p) = file_image("a.img");
+    // Destroy both anchor regions completely.
+    std::fs::write(&p, {
+        let mut v = std::fs::read(&p).unwrap();
+        v[..16384].fill(0);
+        let n = v.len();
+        v[n - 16384..].fill(0);
+        v
+    })
+    .unwrap();
+    assert!(CafsCtx::mount(&p, true).is_err());
+
+    let mut c = CafsCtx::mount_with(&p, true, MountMode::Bypass).unwrap();
+    assert!(c.anchors().is_empty());
+    let mut b = [0xAAu8; 8];
+    c.read_block(ByteOffset(0), &mut b).unwrap();
+    assert_eq!(b, [0u8; 8]);
+    c.write_block(ByteOffset(4096), b"RAWWRITE").unwrap();
+    c.sync().unwrap();
+    drop(c);
+    let on_disk = std::fs::read(&p).unwrap();
+    assert_eq!(&on_disk[4096..4104], b"RAWWRITE");
+}
+
+#[test]
+fn bypass_refuses_check_and_confirm_but_allows_scan_and_remount() {
+    let (_d, p) = file_image("a.img");
+    let mut c = CafsCtx::mount_with(&p, true, MountMode::Bypass).unwrap();
+    assert!(matches!(c.check(), Err(CafsError::Bypassed)));
+    assert!(matches!(c.confirm(), Err(CafsError::Bypassed)));
+    assert_eq!(c.scan_anchors().len(), 6);
+    c.remount(&MountOpts::default()).unwrap();
+}
+
+#[test]
+fn every_device_access_is_bounds_checked_and_never_grows_the_image() {
+    let (_d, p) = file_image("a.img");
+    let mut c = CafsCtx::mount_with(&p, true, MountMode::Bypass).unwrap();
+    let mut b = [0u8; 16];
+    assert_eq!(c.read_block(ByteOffset(SZ - 8), &mut b), Err(CafsError::OutOfRange));
+    assert_eq!(c.write_block(ByteOffset(SZ - 8), &b), Err(CafsError::OutOfRange));
+    assert_eq!(c.write_block(ByteOffset(u64::MAX - 4), &b), Err(CafsError::OutOfRange));
+    drop(c);
+    assert_eq!(std::fs::metadata(&p).unwrap().len(), SZ);
+}
+
+#[test]
+fn bypass_readonly_open_rejects_writes() {
+    let (_d, p) = file_image("a.img");
+    let mut c = CafsCtx::mount_with(&p, false, MountMode::Bypass).unwrap();
+    assert_eq!(c.write_block(ByteOffset(0), &[1]), Err(CafsError::Readonly));
+}
