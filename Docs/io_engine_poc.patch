+/// blocks" but states neither the order nor the exact offsets.
+pub const fn tail_slot_offset(slot: u8, device_size: u64) -> ByteOffset {
+    ByteOffset(device_size - ANCHOR_REGION_BYTES + head_slot_offset(slot).0)
