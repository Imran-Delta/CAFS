# =================================================================
# APPENDIX D: ATOMIC PROTOCOLS SUMMARY (v14 – v3.1)
# =================================================================
#
# 1. Universal Superblock Commit (Routine Updates):
#    - Write new LBA 0. fsync().
#    - Write LBA 1 as a byte-for-byte copy of LBA 0. fsync().  <-- MANDATORY
#    - Compute LBA 3 = LBA 0 XOR LBA 2. Write LBA 3. fsync().
#
# 2. Pointer Table Update (when any dynamic pointer changes):
#    - Write new LBA 4 (Primary Pointer Table) with new generation. fsync().
#    - Write new LBA 2 (Config Snapshot) with new generation. fsync().
#    - Write new LBA 0 (Superblock) with new generation. fsync().
#    - Write LBA 1 as a byte-for-byte copy of LBA 0. fsync().  <-- MANDATORY
#    - Compute LBA 3 = LBA 0 XOR LBA 2. Write LBA 3. fsync().
#    - Write new LBA 5 (Backup Pointer Table) - byte-for-byte copy of LBA 4. fsync().
#    - Write new config_generation to WAL Primary and Backup headers. fsync().
#
#    Rationale: This order preserves the old backup pointer table (LBA 5)
#    until the anchor blocks (LBA 0/1/2) are safely committed. If a crash
#    occurs after LBA 4 is written but before LBA 0/1/2, the backup (LBA 5)
#    still holds the old generation, matching LBA 0. Mount recovery will
#    detect the mismatch and restore LBA 4 from LBA 5, keeping the system
#    mountable. If the crash occurs after LBA 0/1/2 but before LBA 5, the
#    primary (LBA 4) is already valid and matches the anchor; the backup
#    is stale but harmless and will be overwritten on the next update.
#
# 3. Config Sync (myfs.sync-config, for LBA 2 changes):
#    - Write new LBA 2. fsync().
#    - Write new LBA 0. fsync().
#    - Write LBA 1 as a byte-for-byte copy of LBA 0. fsync().  <-- MANDATORY
#    - Compute LBA 3 = LBA 0 XOR LBA 2. Write LBA 3. fsync().
#    - Write config_generation to WAL headers. fsync().
#    - Atomic rename conf.tmp → config.fs.
#
# 4. Mount-Time Recovery (Symmetric Fallback) – CORRECTED ORDER:
#    a. Read all anchor blocks (LBA0-5). Treat I/O errors as checksum failures.
#
#    b. Superblock Recovery (LBA0/LBA1):
#       - Verify LBA0 using anchor_checksum_algo_id from LBA0 itself (offset 64-67).
#       - If LBA0 valid: use it.
#       - Else if LBA1 valid: copy to LBA0 and use it.
#       - Else (both dead):
#            - Read anchor_checksum_algo_id directly from LBA2 offset 52-55.
#              (Since format_version == 3, this must be ID 1; driver may hardcode 1.)
#            - If LBA2 valid and LBA3 valid (LBA2 XOR LBA3 == SUPB magic):
#                 reconstruct LBA0 = LBA2 XOR LBA3; write LBA0 and LBA1; fsync.
#            - Else: REFUSE MOUNT.
#
#    c. Config Snapshot Recovery (LBA2):
#       - Use the verified anchor_checksum_algo_id from LBA0 (or from LBA2 itself
#         if LBA0 was just reconstructed) to verify LBA2.
#       - If LBA2 valid: use it.
#       - Else if LBA0 and LBA3 valid and (LBA0 XOR LBA3) matches CFGS magic:
#            reconstruct LBA2 = LBA0 XOR LBA3; write LBA2; fsync.
#       - Else: REFUSE MOUNT.
#
#    d. Pointer Table Recovery (LBA4/LBA5):
#       - Use the verified anchor_checksum_algo_id from LBA0 to verify LBA4 and LBA5.
#       - Select the first valid table whose generation matches either LBA0.generation
#         or LBA2.generation (they may differ at this point).
#       - If no table valid: REFUSE MOUNT.
#       - Extract WAL LBA from the selected pointer table (offset 8-15).
#
#    e. Generation Match & Parity Healing:
#       - If LBA0.generation == LBA2.generation:
#            - Recompute expected_parity = LBA0 XOR LBA2.
#            - If on-disk LBA3 != expected_parity: overwrite LBA3 with expected_parity and fsync().
#       - If mismatch:
#            - Read WAL.gen (from WAL header using LBA obtained in step d).
#            - If WAL.gen == LBA0.gen:
#                 restore LBA2 = LBA0 XOR LBA3; verify LBA2 checksum; if valid, write LBA2; recompute LBA3.
#            - Else if WAL.gen == LBA2.gen:
#                 restore LBA0 = LBA2 XOR LBA3; verify LBA0 checksum; if valid, write LBA0, LBA1; recompute LBA3.
#            - Else: REFUSE MOUNT.
#
#    f. Final Pointer Table Verification:
#       - After generation unification, verify the selected pointer table's generation
#         matches the unified generation. If not, try the other table.
#       - If no table matches: REFUSE MOUNT.
#
#    g. Proceed to mount.
#
# 5. Relocation Log Intent Types (extension for bad blocks):
#    - 0x01: DEFRAG – standard extent relocation.
#    - 0x02: BAD_BLOCK_RELOC – relocation due to checksum failure or media error.
#      This entry stores old LBA, new LBA, and owning inode/extent ID for potential replay.
# =================================================================

# =================================================================
# APPENDIX E: ALGORITHM IDENTIFIER MAPPING
# =================================================================
# All IDs are stored as uint32 (little-endian) in the binary layouts.
# =================================================================

# data_checksum_algo_id (used in LBA0 & LBA2)
#   0 = none
#   1 = crc32c
#   2 = xxhash64   <-- default
#   3 = blake3

# anchor_checksum_algo_id (used in LBA0 & LBA2 & LBA4/LBA5)
#   1 = blake3-128 (16-byte output)   <-- ONLY VALID ID FOR VERSION 3
#   (Other values reserved for future; changing this after mkfs is forbidden)

# root_hash_algo_id (used in LBA0)
#   0 = none
#   1 = blake3     <-- default
#   2 = sha256

# compression_algo (used in LBA2, offset 88)
#   0 = none
#   1 = zstd       <-- default
#   2 = lz4
# =================================================================

# =================================================================
# APPENDIX F: INODE STRUCTURE (v14)
# =================================================================
# Inodes are stored in the B+ Tree (key = inode_number).
# Each inode is 128 bytes.
#
# Offset 0-3   : magic = 0x494E4F44 ("INOD")
# Offset 4-7   : inode_number (uint32)
# Offset 8-11  : mode (uint16)          <-- RWX bits (owner/group/other)
# Offset 12-15 : uid (uint32)
# Offset 16-19 : gid (uint32)
# Offset 20-27 : size (uint64)
# Offset 28-35 : atime (uint64)
# Offset 36-43 : mtime (uint64)
# Offset 44-51 : ctime (uint64)
# Offset 52-53 : flags (uint16)         <-- See flags table below
# Offset 54-55 : nlink (uint16)
# Offset 56-63 : blocks (uint64)        <-- Number of 512-byte blocks
# Offset 64-71 : xattr_lba (uint64)     <-- Pointer to extended attributes (B+ Tree)
# Offset 72-79 : rec_lba (uint64)       <-- Pointer to recovery block (if RECOVERY flag set)
# Offset 80-87 : pad (8 bytes)          <-- Reserved for future
# =================================================================

# =================================================================
# APPENDIX G: FLAGS TABLE (16 bits)
# =================================================================
# Bit | Flag                 | Value   | Description
# 0   | OPT_READ             | 0x0001  | Optimize for reads (aggressive cache)
# 1   | OPT_WRITE            | 0x0002  | Optimize for writes (aggressive flush)
# 2   | OPT_SEQUENTIAL       | 0x0004  | Sequential access (use extent list)
# 3   | OPT_RANDOM           | 0x0008  | Random access (bypass extent list)
# 4   | OPT_JOURNAL          | 0x0010  | Use WAL for writes (journal mode)
# 5   | OPT_HASH             | 0x0020  | Use hash table for directory lookups
# 6   | OPT_EXTENT           | 0x0040  | Use extent list for writes
# 7   | OPT_BTREE            | 0x0080  | Bypass accelerators, use B+ Tree directly
# 8   | OPT_RAW              | 0x0100  | Bypass compression, dedup, COW
# 9   | OPT_READ_ONLY        | 0x0200  | File cannot be modified
# 10  | OPT_APPEND_ONLY      | 0x0400  | Only append operations allowed
# 11  | OPT_DELETE_ONLY      | 0x0800  | File can only be deleted (no read/write)
# 12  | OPT_NOATIME          | 0x1000  | Don't update access time
# 13  | OPT_SYNC             | 0x2000  | Synchronous writes (no WAL buffering)
# 14  | OPT_IMMUTABLE        | 0x4000  | Cannot be changed at all
# 15  | OPT_NOFAIL           | 0x8000  | Don't panic on corruption (return partial data)
# =================================================================

# =================================================================
# APPENDIX H: WAL ENTRY FORMAT
# =================================================================
# Each WAL entry is 48 bytes:
#   Offset 0   : operation_type (uint8)
#                 0x01 = INSERT
#                 0x02 = DELETE
#                 0x03 = UPDATE
#                 0x04 = CHECKPOINT
#   Offset 1-16 : key (16 bytes)        <-- myfs_key_t
#   Offset 17-32: value (16 bytes)
#   Offset 33-40: checksum (uint64)     <-- xxhash64 over op_type + key + value
#   Offset 41-47: sequence_number (uint64)
# =================================================================

# =================================================================
# APPENDIX I: B+ TREE NODE LAYOUT
# =================================================================
# Node size = block_size (from config)
# Common Header (40 bytes):
#   Offset 0-3   : magic = 0x42545245 ("BTRE")
#   Offset 4-5   : flags (uint16) – bit 0: leaf (1), internal (0)
#   Offset 6-7   : key_count (uint16)
#   Offset 8-15  : parent_lba (uint64) – 0 = root
#   Offset 16-23 : left_sibling (uint64) – 0 = none
#   Offset 24-31 : right_sibling (uint64) – 0 = none
#   Offset 32-39 : checksum (uint64) – xxhash64 over rest of node
#
# Internal Node (after header):
#   keys (key_count * key_size) followed by child pointers ((key_count + 1) * 8)
#
# Leaf Node (after header):
#   keys (key_count * key_size) followed by values (key_count * value_size)
# =================================================================

