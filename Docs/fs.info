# =================================================================
# MYFS FILESYSTEM INFORMATION (v14 – format version 3)
# =================================================================
# This file documents the on-disk layout, binary structures,
# and atomic update protocols. It is NOT a configuration file.
#
# =================================================================
# TO THE AUDITOR: FOUR CRITICAL DESIGN DECISIONS
# =================================================================
# 1. B+ Tree is the ONLY persistent structure.
#    No full hash table, no extent list. Only B+ Tree + WAL survive crashes.
#
# 2. WAL is the ONLY write buffer.
#    No separate extent list for writes. WAL handles batching + crash recovery.
#
# 3. Hot Hash Cache is volatile (RAM only) and read-only.
#    Never authoritative. Invalidated on writes. Cache miss = B+ Tree fallback.
#
# 4. Scaling is addressed honestly.
#    100M files = 1-2 GB RAM (reasonable). Warnings given if cache insufficient.
#    Beyond single-node: sharding or distributed design (not in v1).
# =================================================================

# =================================================================
# CONFIGURATION PERSISTENCE NOTE
# =================================================================
# LBA2 stores ONLY crash-critical parameters.
# [mount_hints], [buffer], and [optimization] are NOT stored in LBA2.
# They are read from config.fs at mount time and overridden by command-line.
# =================================================================

# --------------------------------------------------------------
# STATIC ANCHOR LAYOUT (LBA 0-3) - FIXED, NEVER SHIFTS
# --------------------------------------------------------------
# LBA 0: Primary Superblock (4KB) - contains runtime fields
# LBA 1: Backup Superblock (4KB) - byte-for-byte copy of LBA 0
# LBA 2: Critical Config Snapshot (4KB) - all layout parameters + B+ Tree root
# LBA 3: Parity Block (LBA0 XOR LBA2) over the entire 4KB
# --------------------------------------------------------------

# --------------------------------------------------------------
# POINTER TABLE (LBA 4 & 5) - FIXED 4KB BLOCK WITH 8 ENTRIES
# --------------------------------------------------------------
# Offset 0-7   : Zone Table LBA (uint64)
# Offset 8-15  : WAL Region LBA (uint64)
# Offset 16-23 : Relocation Log Head LBA (uint64)
# Offset 24-31 : Relocation Log Tail LBA (uint64)
# Offset 32-39 : Dedup Table Root LBA (uint64)
# Offset 40-47 : Compaction Checkpoint LBA (uint64)
# Offset 48-55 : Fsck Scratch LBA (uint64)
# Offset 56-63 : pointer_table_generation (uint64) <-- MUST match LBA0.config_generation
# Offset 64-4079: reserved (zero)
# Offset 4080-4095: checksum (16 bytes) -- computed with anchor_checksum_algo from LBA2
#
# LBA 4 = Primary Pointer Table
# LBA 5 = Backup Pointer Table (byte-for-byte copy of LBA 4)
# --------------------------------------------------------------

# --------------------------------------------------------------
# DYNAMIC STRUCTURES (LBA 6+) - POINTED TO BY TABLE
# --------------------------------------------------------------
# Zone Table         : LBA = pointer_table[0]
# WAL Region         : LBA = pointer_table[1]
# Relocation Log     : LBA = pointer_table[2] (head), pointer_table[3] (tail)
# Dedup Table        : LBA = pointer_table[4]
# Compaction Chkpt   : LBA = pointer_table[5]
# Fsck Scratch       : LBA = pointer_table[6]
# --------------------------------------------------------------

# =================================================================
# APPENDIX A: SUPERBLOCK (LBA 0 & 1) BINARY LAYOUT (v3)
# =================================================================
# LBA 0 (Primary Superblock) - 4KB:
#   Offset 0-3   : magic = 0x53555042 ("SUPB")
#   Offset 4-7   : format_version (uint32)          <-- MUST be 3
#   Offset 8-23  : volume_uuid (16 bytes)
#   Offset 24-31 : config_generation (uint64)
#   Offset 32-39 : pointer_table_lba (uint64)       <-- always 4
#   Offset 40-47 : journal_sequence (uint64)
#   Offset 48-55 : last_mount_time (uint64)         <-- 0 = dirty
#   Offset 56-59 : flags (uint32)                   <-- 0x1 clean, 0x2 fsck required, 0x10 flipped
#   Offset 60-63 : data_checksum_algo_id (uint32)   <-- for user data, not used for anchors
#   Offset 64-67 : anchor_checksum_algo_id (uint32) <-- MUST match LBA2.anchor_checksum_algo_id
#   Offset 68-71 : root_hash_algo_id (uint32)
#   Offset 72-4079: zero padding
#   Offset 4080-4095: checksum (16 bytes)            <-- anchor checksum over bytes 0-4079
#
# LBA 1: byte-for-byte copy of LBA 0.
# =================================================================

# =================================================================
# APPENDIX B: POINTER TABLE (LBA 4 & 5) - PACKED 4KB BLOCK
# =================================================================
# Offset 0-7   : Zone Table LBA (uint64)
# Offset 8-15  : WAL Region LBA (uint64)
# Offset 16-23 : Relocation Log Head LBA (uint64)
# Offset 24-31 : Relocation Log Tail LBA (uint64)
# Offset 32-39 : Dedup Table Root LBA (uint64)
# Offset 40-47 : Compaction Checkpoint LBA (uint64)
# Offset 48-55 : Fsck Scratch LBA (uint64)
# Offset 56-63 : pointer_table_generation (uint64) <-- MUST match LBA0.config_generation
# Offset 64-4079: reserved (zero)
# Offset 4080-4095: checksum (16 bytes)             <-- anchor checksum over bytes 0-4079
#
# LBA 4 = Primary Pointer Table
# LBA 5 = Backup Pointer Table (byte-for-byte copy)
# =================================================================

